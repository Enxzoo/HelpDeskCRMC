/* dashboard.css
   HELPDESKCRMC — complete student flow with Ben interactive assistant
   Adapted from student_flow_v5.html mockup
*/

:root{
  --bg:#EFF3FF;
  --surface:#FFFFFF;
  --ink:#1E1B22;
  --muted:#8A8593;
  --line:#ECEAF0;
  --maroon:#2171B5;
  --maroon-dark:#1557A0;
  --gold:#6BAED6;
  --green:#2F8F5B;
  --shadow: 0 10px 30px rgba(20,10,20,.06);
  --shadow-sm: 0 4px 14px rgba(20,10,20,.05);
  --radius-xl:26px;
  --radius-lg:20px;
  --radius-md:14px;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{background:linear-gradient(135deg,#EFF3FF 0%,#E7F0FB 48%,#F7F9FD 100%);color:var(--ink);font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased;}
a{text-decoration:none;color:inherit;}
button{font-family:inherit;cursor:pointer;}

/* ================= APP SHELL ================= */
.app{display:grid;grid-template-columns:250px 1fr;min-height:100vh;}
.sidebar{background:rgba(255,255,255,.78);border-right:1px solid #D9E8F4;padding:26px 20px;display:flex;flex-direction:column;gap:30px;backdrop-filter:blur(12px);}
.brand{display:flex;flex-direction:column;gap:2px;}
.brand-logo{width:166px;height:auto;display:block;object-fit:contain;object-position:left center;}
.brand .n{font-weight:700;font-size:15px;line-height:1.2;}
.brand .s{font-size:11.5px;color:var(--muted);}
.nav-group{display:flex;flex-direction:column;gap:2px;}
.nav-label{font-size:11px;color:var(--muted);font-weight:600;margin:0 10px 6px;}
.nav-group nav{display:flex;flex-direction:column;gap:2px;}
.nav-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:12px;font-size:13.5px;font-weight:500;color:#635C6A;}
.nav-item svg{width:18px;height:18px;flex-shrink:0;}
.nav-item:hover{background:#F7F5F9;}
.nav-item.active{background:#2171B5;color:#fff;box-shadow:0 8px 18px rgba(33,113,181,.2);}
.nav-item.active svg{color:#fff;}
.side-promo{margin-top:auto;background:linear-gradient(160deg,#8E2436,#6E1A29);border-radius:20px;padding:20px 18px;color:#fff;position:relative;overflow:hidden;}
.side-promo::after{content:"";position:absolute;top:-30px;right:-30px;width:110px;height:110px;border-radius:50%;background:rgba(217,165,68,.35);}
.side-promo h4{margin:0 0 6px;font-size:14px;position:relative;}
.side-promo p{margin:0;font-size:12px;color:#EAD3D8;line-height:1.5;position:relative;}
.side-promo button{background:rgba(255,255,255,.2);color:#fff;border:1px solid rgba(255,255,255,.3);padding:9px 16px;border-radius:999px;font-size:12px;font-weight:600;margin-top:10px;position:relative;}
.side-promo button:hover{background:rgba(255,255,255,.3);}

main{padding:30px 44px 60px;max-width:1100px;}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px;}
.topbar .who .n{font-size:15px;font-weight:700;}
.topbar .who .s{font-size:12.5px;color:var(--muted);margin-top:2px;}
.top-actions{display:flex;align-items:center;gap:12px;}
.icon-btn{background:var(--surface);border:1px solid var(--line);width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative;}
.icon-btn svg{width:18px;height:18px;color:var(--muted);}
.icon-btn .dot{position:absolute;top:9px;right:9px;width:7px;height:7px;border-radius:50%;background:var(--maroon);border:2px solid var(--surface);}
.avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#F4C978,#8E2436);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px;}

/* ================= DASHBOARD HOME ================= */
.hero{position:relative;border-radius:var(--radius-xl);padding:42px 38px;overflow:hidden;background:var(--surface);box-shadow:var(--shadow);margin-bottom:26px;}
.hero-glow2{position:absolute;inset:0;pointer-events:none;background:radial-gradient(420px 260px at 12% 0%, rgba(142,36,54,.12), transparent 60%),radial-gradient(360px 240px at 92% 0%, rgba(217,165,68,.18), transparent 60%);}
.hero-content{position:relative;text-align:center;}
.hero-ben{width:86px;height:86px;object-fit:contain;display:block;margin:0 auto 8px;border-radius:50%;box-shadow:0 10px 22px rgba(33,113,181,.18);}
.eyebrow{display:inline-flex;align-items:center;gap:7px;background:#FBF1E0;color:#9C6E17;font-size:12px;font-weight:600;padding:6px 14px;border-radius:999px;margin-bottom:14px;}
.eyebrow .b{width:6px;height:6px;border-radius:50%;background:var(--gold);}
.hero h1{font-size:26px;margin:0 0 8px;font-weight:800;letter-spacing:-.4px;}
.hero p{margin:0 0 20px;color:var(--muted);font-size:14px;max-width:520px;margin-left:auto;margin-right:auto;}

.cta-pill{background:var(--ink);color:#fff;border:none;padding:14px 24px;border-radius:999px;font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:9px;transition:all .2s ease;}
.cta-pill svg{width:16px;height:16px;}
.cta-pill:hover{background:var(--maroon);transform:translateY(-1px);box-shadow:0 8px 20px rgba(142,36,54,.3);}

/* ================= OVERVIEW + CONCERN LIST ================= */
.lower-grid{display:grid;grid-template-columns:0.85fr 1.4fr;gap:22px;}
.status-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);padding:26px 24px;box-shadow:var(--shadow-sm);}
.status-card h3{margin:0 0 6px;font-size:16.5px;font-weight:700;}
.status-card p{margin:0 0 18px;font-size:12.5px;color:var(--muted);line-height:1.55;}
.status-line{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-top:1px solid var(--line);}
.status-line:first-of-type{border-top:none;}
.status-line .lbl{display:flex;align-items:center;gap:9px;font-size:13px;font-weight:500;}
.status-line .dot2{width:9px;height:9px;border-radius:50%;}
.status-line .val{font-size:15px;font-weight:700;}
.amber{background:var(--gold);} .maroonc{background:var(--maroon);} .greenc{background:var(--green);} .bluec{background:#3E7CB1;}
.contact-note{margin-top:16px;padding-top:16px;border-top:1px solid var(--line);font-size:12px;color:var(--muted);line-height:1.5;}
.contact-note a{color:var(--maroon);font-weight:600;}

.faq-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);padding:22px 24px;box-shadow:var(--shadow-sm);}
.faq-card .head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;}
.faq-card h3{margin:0;font-size:16.5px;font-weight:700;}
.faq-card .head a{font-size:12.5px;color:var(--maroon);font-weight:600;}
.faq-card .head a:hover{text-decoration:underline;}

.faq-row{border-top:1px solid var(--line);cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:14px 4px;gap:12px;transition:background .15s ease;}
.faq-row:first-of-type{border-top:none;}
.faq-row:hover{background:#F7F6F9;}
.faq-row.open{background:#F7F6F9;}
.faq-row .left{display:flex;flex-direction:column;gap:4px;min-width:0;flex:1;}
.faq-row .subject{font-size:13.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.faq-row .meta{font-size:11.5px;color:var(--muted);}
.faq-row .right{display:flex;align-items:center;gap:12px;flex-shrink:0;}
.tag{font-size:10.5px;font-weight:700;padding:4px 10px;border-radius:999px;white-space:nowrap;}
.tag.pending{background:#FBF1E0;color:#9C6E17;}
.tag.progress{background:#F6E4E7;color:var(--maroon);}
.tag.resolved{background:#E4F3EA;color:var(--green);}
.chev{width:15px;height:15px;color:#C7C2CE;transition:transform .15s ease;}
.faq-row.open .chev{transform:rotate(90deg);}
.concern-detail{padding:0 4px 16px;display:none;}
.reply-box{background:#F7F6F9;border-radius:12px;padding:14px 16px;}
.reply-head{font-size:11px;font-weight:700;color:var(--maroon);margin-bottom:6px;text-transform:uppercase;letter-spacing:.03em;}
.reply-msg{font-size:12.5px;line-height:1.6;color:var(--ink);}
.reply-empty{font-size:12px;color:var(--muted);padding:0 4px;}

/* ================= BEN FLOW OVERLAY ================= */
#benFlow{
  display:none;position:fixed;inset:0;background:#fff;
  z-index:999;overflow-y:auto;
}
.bf-modal{
  max-width:760px;margin:0 auto;padding:36px 24px 50px;
  min-height:100vh;display:flex;flex-direction:column;
}
.bf-header{
  display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;
}
.bf-header-l{display:flex;align-items:center;gap:12px;}
.bf-mascot{
  width:130px;height:130px;
  display:flex;align-items:center;justify-content:center;
}
.bf-mascot svg{width:130px;height:130px;}
.bf-mascot img{width:130px;height:130px;object-fit:contain;border-radius:50%;}
.bf-header-txt .n{font-size:16px;font-weight:700;line-height:1.2;}
.bf-header-txt .s{font-size:12px;color:var(--muted);margin-top:2px;}
.bf-exit{
  background:none;border:none;width:34px;height:34px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;color:var(--muted);
}
.bf-exit:hover{background:#F7F6F9;color:var(--ink);}
.bf-exit svg{width:20px;height:20px;}
.bf-back{
  font-size:13px;font-weight:600;color:var(--muted);
  background:none;border:none;display:flex;align-items:center;gap:6px;padding:0;
}
.bf-back:hover{color:var(--maroon);}
.bf-logo{height:42px;width:auto;}

#bfStep1{
  flex:1;display:flex;flex-direction:column;align-items:center;
  justify-content:center;text-align:center;gap:20px;padding:30px 0;
}
#bfStep1 h1{font-size:21px;font-weight:800;margin:0;}
.bf-step1-head{display:flex;flex-direction:column;align-items:center;gap:20px;}
.bf-step1-head h2{font-size:11.5px;font-weight:700;letter-spacing:.06em;color:var(--muted);
  text-transform:uppercase;margin:0;}
.bf-back-cats{
  font-size:12px;font-weight:700;color:var(--maroon);
  background:none;border:none;padding:0;margin-top:-8px;
  display:flex;align-items:center;gap:5px;
}
.bf-back-cats:hover{text-decoration:underline;}

.bf-cat-scroll{width:100%;max-width:100%;overflow:visible;}
.bf-cat-row{
  display:flex;gap:14px;overflow-x:auto;max-width:100%;
  padding:6px 4px 12px;scroll-snap-type:x mandatory;
  scrollbar-width:none;-ms-overflow-style:none;
}
.bf-cat-row::-webkit-scrollbar{display:none;}
.bf-cat-card{
  scroll-snap-align:start;flex:0 0 128px;
  background:#1E1922;border:none;border-radius:18px;
  padding:20px 12px;display:flex;flex-direction:column;
  align-items:center;gap:12px;color:#fff;
  transition:background .15s ease, transform .15s ease, box-shadow .15s ease;
}
.bf-cat-card svg{width:26px;height:26px;color:#fff;}
.bf-cat-card .lbl{
  font-size:11px;font-weight:800;letter-spacing:.02em;
  text-transform:uppercase;text-align:center;line-height:1.25;
}
.bf-cat-card:hover{
  background:var(--maroon);transform:translateY(-4px);
  box-shadow:0 12px 22px rgba(142,36,54,.28);
}

/* Homepage blue theme overrides */
.sidebar{background:#fff;border-right-color:#BDD7E7;}
.nav-item:hover{background:#EFF3FF;}
.side-promo{background:linear-gradient(160deg,#2171B5,#1557A0);}
.side-promo p{color:#DCEEFF;}
.avatar{background:linear-gradient(135deg,#6BAED6,#2171B5);}
.hero-glow2{background:radial-gradient(420px 260px at 12% 0%,rgba(33,113,181,.14),transparent 60%),radial-gradient(360px 240px at 92% 0%,rgba(107,174,214,.24),transparent 60%);}
.eyebrow{background:#EFF3FF;color:#1557A0;}
.cta-pill:hover{background:#2171B5;box-shadow:0 8px 20px rgba(33,113,181,.3);}
.contact-note a,.faq-card .head a{color:#2171B5;}
.tag.progress{background:#E5F1FA;color:#1557A0;}
.tag.pending{background:#EFF3FF;color:#2171B5;}
.bf-cat-card:hover{background:#2171B5;box-shadow:0 12px 22px rgba(33,113,181,.28);}
.bf-office-pill{background:#2171B5;}
.bf-ben-ic{background:linear-gradient(135deg,#6BAED6,#2171B5);}
.bf-chip:hover{border-color:#2171B5;background:#EFF3FF;color:#1557A0;}
.bf-chip.escalate{border-color:#2171B5;color:#1557A0;}
.bf-chip.escalate:hover{background:#2171B5;color:#fff;}
.bf-student-bubble{background:#2171B5;}
.bf-send.active:hover{background:#2171B5;}

/* Student-first dashboard */
.app{display:grid;grid-template-columns:250px 1fr;min-height:100vh;}
main{padding:30px 44px 60px;max-width:1180px;}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px;}
#dashHome{max-width:none;margin:0;}
.hero{
  display:grid;
  grid-template-columns:1.25fr .75fr;
  align-items:center;
  min-height:270px;
  padding:36px 46px;
  background:linear-gradient(135deg,rgba(255,255,255,.9) 0%,rgba(247,251,255,.78) 100%);
  border:1px solid rgba(189,215,231,.7);
}
.hero-content{position:relative;text-align:left;}
.hero-copy{position:relative;z-index:2;max-width:620px;}
.hero-copy h1{font-size:32px;line-height:1.18;margin:0 0 12px;max-width:560px;}
.hero-copy p{margin:0 0 22px;max-width:530px;line-height:1.6;}
.hero-copy .cta-pill{background:#2171B5;box-shadow:0 8px 20px rgba(33,113,181,.22);}
.hero-copy .cta-pill:hover{background:#1557A0;}
.hero-visual{position:relative;display:flex;align-items:center;justify-content:center;min-height:190px;}
.hero-visual-ring{position:absolute;width:190px;height:190px;border-radius:50%;background:#EFF3FF;border:1px solid #BDD7E7;}
.hero-ben{position:relative;width:160px;height:160px;margin:0;object-fit:contain;z-index:1;}
.hero-online{position:absolute;right:4px;bottom:18px;background:#fff;border:1px solid #E6E3EB;border-radius:999px;padding:7px 11px;color:#2F8F5B;font-size:11px;font-weight:700;box-shadow:0 5px 14px rgba(33,73,125,.1);z-index:2;}
.hero-online span{display:inline-block;width:7px;height:7px;border-radius:50%;background:#2F8F5B;margin-right:5px;}
.office-section{margin-bottom:24px;}
.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:12px;}
.section-heading h2{margin:0 0 4px;font-size:18px;font-weight:800;}
.section-heading p{margin:0;color:var(--muted);font-size:13px;}
.text-action{border:0;background:none;color:#2171B5;font-size:12px;font-weight:700;padding:4px;cursor:pointer;}
.text-action:hover{text-decoration:underline;}
.office-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.office-shortcut{display:grid;grid-template-columns:38px 1fr auto;align-items:center;gap:10px;text-align:left;background:#fff;border:1px solid #E6EAF2;border-radius:16px;padding:14px 13px;box-shadow:var(--shadow-sm);transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease;}
.office-shortcut:hover{transform:translateY(-2px);border-color:#BDD7E7;box-shadow:0 9px 20px rgba(33,73,125,.1);}
.office-shortcut strong{display:block;color:var(--ink);font-size:13px;}
.office-shortcut small{display:block;color:var(--muted);font-size:10px;margin-top:3px;white-space:nowrap;}
.office-icon{width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:19px;font-weight:800;}
.office-icon.registrar{background:#EFF3FF;color:#2171B5;}
.office-icon.finance{background:#EAF5FB;color:#2F8F5B;}
.office-icon.saso{background:#E8F1F8;color:#6BAED6;}
.office-icon.library{background:#F0F5FB;color:#1557A0;}
.office-arrow{color:#A4B8CA;font-size:17px;}

/* Ben conversation card */
#benFlow{
  background:rgba(232,244,248,0.6);
  display:none;
  align-items:center;
  justify-content:center;
  padding:0;
  position:fixed;
  top:0;
  left:0;
  right:0;
  bottom:0;
  z-index:9999;
}
#benFlow .bf-modal{
  width:100%;
  max-width:680px;
  min-height:0;
  height:min(760px, calc(100vh - 40px));
  padding:0;
  background:#fff;
  border:1px solid #D5E3EC;
  border-radius:16px;
  box-shadow:0 8px 32px rgba(0,0,0,0.12);
  overflow:hidden;
  display:flex;
  flex-direction:column;
}
#bfStep2{
  min-height:0;
  height:100%;
  background:#fff;
  display:flex;
  flex-direction:column;
}
.bf-step2-head{
  min-height:auto;
  padding:20px 24px;
  border-bottom:1px solid #E8EEF2;
  background:#FFFFFF;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  flex-shrink:0;
}
.bf-step2-head > button{
  position:static;
  margin:0;
  color:#7F8C8D;
  background:none;
  border:none;
  padding:8px;
  cursor:pointer;
  border-radius:8px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.bf-step2-head > button:hover{
  background:#F7F9FA;
}
.bf-step2-head > button svg{
  width:20px;
  height:20px;
}
.bf-chat-identity{
  flex:1;
  display:flex;
  align-items:center;
  gap:14px;
}
.bf-chat-avatar{
  width:48px;
  height:48px;
  border-radius:50%;
  background:#2A3F5F;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  flex-shrink:0;
}
.bf-chat-avatar img{
  width:48px;
  height:48px;
  object-fit:cover;
}
.bf-chat-name{
  color:#2C3E50;
  font-size:15px;
  font-weight:600;
  line-height:1.3;
}
.bf-office-pill{
  background:#4A90D9;
  color:#FFFFFF;
  font-size:13px;
  font-weight:600;
  padding:8px 18px;
  border-radius:20px;
  border:none;
  cursor:pointer;
  flex-shrink:0;
  transition:background 0.2s;
}
.bf-office-pill:hover{
  background:#3A7BC8;
}
}
.bf-office-pill{
  margin-left:auto;
  background:#EFF3FF;
  color:#2171B5;
  font-size:10px;
  padding:5px 9px;
}
.bf-thread{
  padding:22px 40px 14px;
  background:#fff;
}
.bf-row{
  margin-bottom:14px;
}
.bf-ben-ic{
  width:32px;
  height:32px;
  min-width:32px;
  background:#EFF3FF;
  overflow:hidden;
}
.bf-ben-ic img{
  width:32px;
  height:32px;
  object-fit:contain;
}
.bf-msg-card{
  background:linear-gradient(135deg,#EFF3FF,#C5DEEF);
  border:0;
  border-radius:15px;
  padding:12px 17px;
  max-width:410px;
}
.bf-msg-card.bf-answer{
  background:linear-gradient(135deg,#EFF3FF,#C5DEEF);
  border:0;
}
.bf-msg-card .q,
.bf-student-bubble{
  font-size:15px;
  line-height:1.45;
}
.bf-msg-card .q{
  color:#1E1B22;
}
.bf-student-bubble{
  background:linear-gradient(135deg,#2171B5,#1557A0);
  padding:12px 18px;
  border-radius:15px;
  max-width:390px;
}
.bf-input-bar{
  padding:14px 40px 26px;
  border-top:0;
  background:#fff;
}
.bf-input-row{
  gap:8px;
  padding:5px 7px 5px 16px;
  background:#F5F4F8;
  border-radius:999px;
}
.bf-attach-btn{
  width:30px;
  height:34px;
  border:0;
  background:transparent;
}
.bf-input-wrap{
  min-width:0;
}
.bf-input{
  min-height:36px;
  max-height:90px;
  border:0;
  background:transparent;
  padding:8px 4px;
  font-size:15px;
}
.bf-input:focus{
  border:0;
  background:transparent;
  box-shadow:none;
}
.bf-send{
  width:40px;
  height:40px;
  border-radius:50%;
  background:#2171B5;
  opacity:.45;
}
.bf-send.active{
  opacity:1;
}
.bf-send.active:hover{
  background:#1557A0;
}

.bf-scroll-track{
  width:220px;height:5px;border-radius:999px;background:#ECEAF0;
  position:relative;margin-top:2px;cursor:pointer;display:none;
}
.bf-scroll-track.show{display:block;}
.bf-scroll-thumb{
  position:absolute;top:-3px;left:0;height:11px;
  border-radius:999px;background:#1E1922;width:40%;
  cursor:grab;touch-action:none;
}
.bf-scroll-thumb:active{cursor:grabbing;background:var(--maroon);}

#bfStep2{display:none;flex-direction:column;flex:1;overflow:hidden;}
.bf-step2-head{padding:16px 28px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;}
.bf-step2-head button{
  background:none;border:none;padding:0;width:28px;height:28px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;color:var(--muted);flex-shrink:0;
}
.bf-step2-head button:hover{background:#F7F6F9;color:var(--ink);}
.bf-step2-head button svg{width:16px;height:16px;}
.bf-office-pill{
  background:var(--maroon);color:#fff;font-size:11.5px;font-weight:700;
  padding:5px 12px;border-radius:999px;text-transform:uppercase;letter-spacing:.03em;
}

.bf-thread{flex:1;overflow-y:auto;padding:20px 28px;background:#E8F4F8;}
.bf-row{display:flex;gap:12px;margin-bottom:20px;align-items:flex-start;}
.bf-row.student{justify-content:flex-end;}
.bf-ben-ic{
  width:40px;height:40px;min-width:40px;border-radius:50%;
  background:#2A3F5F;
  display:flex;align-items:center;justify-content:center;color:#fff;
  flex-shrink:0;
}
.bf-ben-ic img{width:40px;height:40px;border-radius:50%;object-fit:cover;}
.bf-ben-ic svg{width:22px;height:22px;}
.bf-msg-card{
  background:#FFFFFF;border-radius:18px 18px 18px 4px;padding:14px 18px;max-width:520px;
  box-shadow:0 1px 2px rgba(0,0,0,0.08);
}
.bf-msg-card.bf-answer{background:#FFFFFF;border:none;box-shadow:0 1px 2px rgba(0,0,0,0.08);}
.bf-msg-card .q{font-size:14px;line-height:1.6;color:#2C3E50;margin:0;}
.bf-msg-card .sub{font-size:12px;color:#7F8C8D;margin-top:8px;}
.bf-chip-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px;}
.bf-chip{
  background:#FFFFFF;border:1.5px solid #D5E3EC;color:#34495E;
  padding:9px 18px;border-radius:20px;font-size:13px;font-weight:500;transition:all .2s ease;
}
.bf-chip:hover{border-color:#4A90D9;background:#EBF5FB;color:#4A90D9;}
.bf-chip.yes{border-color:#4A90D9;color:#4A90D9;background:#FFFFFF;}
.bf-chip.yes:hover{background:#4A90D9;color:#fff;}
.bf-chip.no{border-color:#BDC3C7;color:#7F8C8D;background:#FFFFFF;}
.bf-chip.no:hover{border-color:#95A5A6;background:#ECF0F1;color:#5D6D7E;}
.bf-chip.escalate{border-color:#4A90D9;color:#4A90D9;background:#FFFFFF;}
.bf-chip.escalate:hover{background:#4A90D9;color:#fff;}

.bf-student-bubble{
  background:#4A90D9;color:#FFFFFF;padding:13px 18px;border-radius:18px 18px 4px 18px;
  font-size:14px;line-height:1.6;max-width:480px;word-wrap:break-word;
  box-shadow:0 2px 6px rgba(74,144,217,0.25);
}
.attach-pill{
  display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.2);
  border:1px solid rgba(255,255,255,.3);padding:4px 10px;border-radius:999px;
  font-size:11px;margin-top:6px;
}
.attach-pill svg{width:12px;height:12px;}

.bf-input-bar{padding:20px 24px;border-top:1px solid #E8EEF2;background:#FFFFFF;}
.bf-attach-chip{
  background:#FBF1E0;border:1px solid #F0E6CC;padding:8px 12px;border-radius:12px;
  margin-bottom:10px;display:none;align-items:center;gap:10px;font-size:12px;
}
.bf-attach-chip.show{display:flex;}
.bf-attach-chip svg{width:16px;height:16px;color:#4A90D9;}
.bf-attach-info{flex:1;min-width:0;}
.bf-attach-name{font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.bf-attach-size{color:var(--muted);font-size:11px;}
.bf-attach-remove{
  background:none;border:none;width:24px;height:24px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;color:var(--muted);flex-shrink:0;
}
.bf-attach-remove:hover{background:rgba(74,144,217,.1);color:#4A90D9;}
.bf-attach-remove svg{width:14px;height:14px;}

.bf-input-row{display:flex;gap:10px;align-items:center;}
.bf-attach-btn{
  background:#FFFFFF;border:1px solid #E0E6EA;width:44px;height:44px;
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  color:#7F8C8D;flex-shrink:0;cursor:pointer;transition:all 0.2s;
}
.bf-attach-btn:hover:not(:disabled){border-color:#4A90D9;color:#4A90D9;background:#F7FBFE;}
.bf-attach-btn:disabled{opacity:.4;cursor:not-allowed;}
.bf-attach-btn svg{width:20px;height:20px;}
.bf-input-wrap{flex:1;position:relative;}
.bf-input{
  width:100%;min-height:44px;max-height:120px;resize:none;
  border:1px solid #E0E6EA;border-radius:24px;padding:12px 50px 12px 18px;
  font-family:inherit;font-size:14px;color:#2C3E50;background:#FFFFFF;
  transition:border-color 0.2s;
}
.bf-input:focus{outline:none;border-color:#4A90D9;background:#fff;}
.bf-input:disabled{background:#F7F9FA;color:#BDC3C7;cursor:not-allowed;}
.bf-input::placeholder{color:#BDC3C7;}
.bf-send{
  background:#4A90D9;border:none;width:44px;height:44px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;color:#fff;
  flex-shrink:0;cursor:pointer;transition:all 0.2s;
  position:absolute;right:2px;top:50%;transform:translateY(-50%);
}
.bf-send:hover:not(:disabled){background:#3A7BC8;box-shadow:0 2px 8px rgba(74,144,217,0.3);}
.bf-send:disabled{opacity:0.5;cursor:not-allowed;}
.bf-send svg{width:20px;height:20px;}

/* ================= STAFF & ADMIN PORTAL STYLES ================= */

/* Stats Grid */
.stats-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
  gap:18px;
  margin-bottom:26px;
}
.stat-card{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
  padding:20px 22px;
  box-shadow:var(--shadow-sm);
  display:flex;
  align-items:center;
  justify-content:space-between;
  transition:transform .15s ease, box-shadow .15s ease;
}
.stat-card:hover{
  transform:translateY(-2px);
  box-shadow:var(--shadow);
}
.stat-info .lbl{
  font-size:12px;
  font-weight:600;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.03em;
  margin-bottom:4px;
}
.stat-info .num{
  font-size:26px;
  font-weight:800;
  color:var(--ink);
  line-height:1.1;
}
.stat-icon{
  width:46px;
  height:46px;
  border-radius:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}
.stat-icon.maroon{background:#F6E4E7;color:var(--maroon);}
.stat-icon.gold{background:#FBF1E0;color:#9C6E17;}
.stat-icon.green{background:#E4F3EA;color:var(--green);}
.stat-icon.blue{background:#E8F1F8;color:#2B6CB0;}
.stat-icon svg{width:22px;height:22px;}

/* Filter & Search Bar */
.filter-bar{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:var(--radius-md);
  padding:14px 18px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  margin-bottom:20px;
  box-shadow:var(--shadow-sm);
  flex-wrap:wrap;
}
.search-box{
  position:relative;
  flex:1;
  min-width:240px;
}
.search-box svg{
  position:absolute;
  left:14px;
  top:50%;
  transform:translateY(-50%);
  width:16px;
  height:16px;
  color:var(--muted);
  pointer-events:none;
}
.search-box input{
  width:100%;
  border:1px solid var(--line);
  border-radius:10px;
  padding:9px 14px 9px 38px;
  font-size:13px;
  font-family:inherit;
  background:#F9F8FA;
  outline:none;
  transition:all .15s ease;
}
.search-box input:focus{
  border-color:var(--maroon);
  background:#fff;
}
.filter-group{
  display:flex;
  align-items:center;
  gap:10px;
}
.filter-group select{
  border:1px solid var(--line);
  border-radius:10px;
  padding:9px 14px;
  font-size:13px;
  font-family:inherit;
  background:#F9F8FA;
  color:var(--ink);
  outline:none;
  cursor:pointer;
}

/* Data Table */
.data-card{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow-sm);
  overflow:hidden;
}
.data-card-head{
  padding:18px 22px;
  border-bottom:1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.data-card-head h3{
  margin:0;
  font-size:16px;
  font-weight:700;
}
.table-wrap{
  width:100%;
  overflow-x:auto;
}
.data-table{
  width:100%;
  border-collapse:collapse;
  font-size:13px;
  text-align:left;
}
.data-table th{
  background:#F9F8FA;
  color:var(--muted);
  font-size:11px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.04em;
  padding:12px 18px;
  border-bottom:1px solid var(--line);
  white-space:nowrap;
}
.data-table td{
  padding:14px 18px;
  border-bottom:1px solid var(--line);
  vertical-align:middle;
  color:var(--ink);
}
.data-table tr:last-child td{
  border-bottom:none;
}
.data-table tr:hover td{
  background:#FAF9FC;
}

/* Badges & Buttons */
.role-badge{
  display:inline-flex;
  align-items:center;
  gap:5px;
  font-size:11px;
  font-weight:700;
  padding:3px 10px;
  border-radius:999px;
  text-transform:capitalize;
}
.role-badge.student{background:#E8F1F8;color:#2B6CB0;}
.role-badge.staff{background:#FBF1E0;color:#9C6E17;}
.role-badge.admin{background:#F6E4E7;color:var(--maroon);}

.btn-sm{
  padding:7px 14px;
  border-radius:8px;
  font-size:12.5px;
  font-weight:600;
  border:none;
  display:inline-flex;
  align-items:center;
  gap:6px;
  transition:all .15s ease;
}
.btn-primary{
  background:var(--maroon);
  color:#fff;
}
.btn-primary:hover{
  background:var(--maroon-dark);
}
.btn-secondary{
  background:#F2F0F5;
  color:var(--ink);
  border:1px solid var(--line);
}
.btn-secondary:hover{
  background:#E6E3EC;
}
.btn-outline{
  background:transparent;
  border:1px solid var(--line);
  color:var(--ink);
}
.btn-outline:hover{
  border-color:var(--maroon);
  color:var(--maroon);
  background:#F6E4E7;
}

/* Modals */
.modal-overlay{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(20,10,20,.45);
  backdrop-filter:blur(4px);
  z-index:1000;
  align-items:center;
  justify-content:center;
  padding:20px;
}
.modal-overlay.active{
  display:flex;
}
.modal-card{
  background:var(--surface);
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow);
  width:100%;
  max-width:580px;
  max-height:90vh;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  animation:modalIn .2s ease-out;
}
@keyframes modalIn{
  from{opacity:0;transform:scale(.96);}
  to{opacity:1;transform:scale(1);}
}
.modal-header{
  padding:20px 24px;
  border-bottom:1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.modal-header h3{
  margin:0;
  font-size:17px;
  font-weight:800;
}
.modal-close{
  background:none;
  border:none;
  font-size:20px;
  color:var(--muted);
  cursor:pointer;
  width:32px;
  height:32px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
}
.modal-close:hover{
  background:#F2F0F5;
  color:var(--ink);
}
.modal-body{
  padding:24px;
  overflow-y:auto;
  flex:1;
}
.modal-footer{
  padding:16px 24px;
  border-top:1px solid var(--line);
  background:#F9F8FA;
  display:flex;
  justify-content:flex-end;
  gap:10px;
}

/* Thread timeline */
.thread-list{
  display:flex;
  flex-direction:column;
  gap:12px;
  margin-top:14px;
}
.thread-bubble{
  background:#F7F6F9;
  border-radius:14px;
  padding:12px 16px;
}
.thread-bubble.staff{
  background:#F6E4E7;
  border:1px solid #EAD0D5;
}
.thread-bubble .author{
  font-size:11.5px;
  font-weight:700;
  color:var(--maroon);
  margin-bottom:4px;
}
.thread-bubble .msg{
  font-size:13px;
  line-height:1.5;
  color:var(--ink);
}
.thread-bubble .time{
  font-size:11px;
  color:var(--muted);
  margin-top:4px;
}

/* Refined dashboard and office picker layout */
#benFlow{
  background:#EFF3FF;
  align-items:center;
  justify-content:center;
  padding:24px;
}
#benFlow .bf-modal{
  width:min(960px, calc(100vw - 48px));
  height:auto;
  min-height:0;
  max-width:none;
  max-height:calc(100vh - 48px);
  padding:26px 30px 30px;
  background:#fff;
  border:1px solid #D9E8F4;
  border-radius:28px;
  box-shadow:0 20px 55px rgba(33,73,125,.14);
  overflow-y:auto;
}
#bfStep1{
  flex:none;
  width:100%;
  min-height:0;
  justify-content:flex-start;
  gap:18px;
  padding:0;
}
#bfStep1 .bf-header{width:100%;margin-bottom:4px;}
#bfStep1 .bf-step1-head{gap:14px;}
#bfStep1 h1{color:var(--ink);font-size:27px;line-height:1.25;}
#bfStep1 .bf-mascot{width:118px;height:118px;margin:2px 0 2px;}
#bfStep1 .bf-mascot img{width:118px;height:118px;}
#bfStep1 .bf-step1-head h2{color:#2171B5;font-size:12px;letter-spacing:.08em;}
.workspace-search{
  flex:1;
  max-width:420px;
  height:42px;
  display:flex;
  align-items:center;
  gap:9px;
  padding:0 14px;
  border-radius:999px;
  background:rgba(255,255,255,.82);
  border:1px solid rgba(189,215,231,.8);
}
.workspace-search svg{
  width:17px;
  height:17px;
  color:#5D6B7D;
  flex-shrink:0;
}
.workspace-search input{
  width:100%;
  border:0;
  outline:0;
  background:transparent;
  color:var(--ink);
  font:inherit;
  font-size:13px;
}
.bf-cat-scroll{width:100%;overflow:hidden;}
.bf-cat-row{
  width:100%;
  display:flex;
  justify-content:center;
  gap:14px;
  padding:6px 2px 14px;
  overflow-x:auto;
  overflow-y:hidden;
}
.bf-cat-card{
  flex:0 0 142px;
  min-height:118px;
  padding:18px 12px;
  background:linear-gradient(160deg,#2171B5,#1557A0);
  border:1px solid rgba(255,255,255,.25);
  border-radius:18px;
  box-shadow:0 8px 18px rgba(33,113,181,.16);
  gap:11px;
}
.bf-cat-card svg{width:27px;height:27px;}
.bf-cat-card .lbl{font-size:11px;line-height:1.3;}
.bf-cat-card:hover{
  background:linear-gradient(160deg,#1557A0,#0D4278);
  transform:translateY(-3px);
  box-shadow:0 12px 22px rgba(33,113,181,.25);
}
.bf-scroll-track{margin:0 auto;background:#DCEAF5;}
.bf-scroll-thumb{background:#2171B5;}

@media (max-width:960px){
  .app{grid-template-columns:1fr;}
  .sidebar{flex-direction:row;overflow-x:auto;align-items:center;padding:16px 18px;}
  .side-promo,.nav-label{display:none;}
  .nav-group nav{display:flex;flex-direction:row;gap:4px;}
  main{padding:22px 18px 40px;}
  .lower-grid{grid-template-columns:1fr;}
  #benFlow{padding:18px;}
  #benFlow .bf-modal{width:min(760px, calc(100vw - 36px));max-height:calc(100vh - 36px);border-radius:24px;}
  .hero{grid-template-columns:1fr;padding:30px 26px;}
  .hero-copy{text-align:center;max-width:none;}
  .hero-copy h1,.hero-copy p{margin-left:auto;margin-right:auto;}
  .hero-copy .cta-pill{margin:0 auto;}
  .hero-visual{min-height:150px;order:-1;}
  .hero-visual-ring{width:150px;height:150px;}
  .hero-ben{width:130px;height:130px;}
  .office-grid{grid-template-columns:repeat(2,1fr);}
}
@media (max-width:600px){
  #benFlow{padding:0;}
  #benFlow .bf-modal{width:100%;height:100vh;max-height:none;border-radius:0;padding:22px 18px 26px;}
  #bfStep1 h1{font-size:23px;}
  #bfStep1 .bf-mascot,#bfStep1 .bf-mascot img{width:104px;height:104px;}
  .bf-cat-row{justify-content:flex-start;gap:12px;}
  .bf-cat-card{flex-basis:132px;}
  .bf-thread{padding-left:20px;padding-right:20px;}
  .bf-input-bar{padding-left:20px;padding-right:20px;}
  .bf-office-pill{display:none;}
  main{padding:22px 16px 40px;}
  .topbar{margin-bottom:22px;}
  .hero-copy h1{font-size:26px;}
  .section-heading{align-items:flex-start;gap:10px;flex-direction:column;}
  .office-grid{grid-template-columns:1fr;}
}

/* Compact Ask Ben dashboard */
.app{
  min-height:100vh;
}
main{
  padding:16px 20px 24px;
}
.topbar{
  margin-bottom:14px;
}
.hero{
  min-height:190px;
  margin-bottom:18px;
  padding:24px 30px;
}
.hero-copy h1{
  font-size:29px;
  margin-bottom:8px;
}
.hero-copy p{
  margin-bottom:14px;
  line-height:1.45;
}
.hero-visual{
  min-height:150px;
}
.hero-visual-ring{
  width:150px;
  height:150px;
}
.hero-ben{
  width:126px;
  height:126px;
}
.hero-online{
  bottom:10px;
  padding:6px 9px;
}
.office-section{
  margin-bottom:18px;
}
.section-heading{
  margin-bottom:10px;
}
.section-heading h2{
  font-size:18px;
}
.section-heading p{
  font-size:12px;
}
.office-grid{
  gap:10px;
}
.office-shortcut{
  min-height:72px;
  padding:10px 12px;
}
.office-icon{
  width:34px;
  height:34px;
  font-size:16px;
}
.office-shortcut strong{
  font-size:12px;
}
.office-shortcut small{
  font-size:10px;
}
.lower-grid{
  gap:12px;
}
.status-card,
.faq-card{
  padding:16px;
}

@media (max-width:960px){
  main{
    padding:16px 18px 28px;
  }
  .hero{
    min-height:0;
    padding:22px 22px;
  }
}

@media (max-width:600px){
  main{
    padding:14px 14px 24px;
  }
  .topbar{
    margin-bottom:14px;
  }
  .hero{
    padding:18px 16px;
    margin-bottom:16px;
  }
  .hero-visual{
    min-height:120px;
  }
  .hero-visual-ring{
    width:120px;
    height:120px;
  }
  .hero-ben{
    width:102px;
    height:102px;
  }
  .hero-copy h1{
    font-size:24px;
  }
  .office-grid{
    gap:8px;
  }
  .office-shortcut{
    min-height:64px;
    padding:8px 10px;
  }
}
